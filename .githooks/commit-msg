#!/bin/sh

set -e

message_file=$1

# 머지 커밋은 메시지를 git 이 만든다. MERGE_HEAD 는 머지 중에만 존재한다.
[ -e "$(git rev-parse --git-path MERGE_HEAD)" ] && exit 0

# git 이 커밋 직전에 버리는 부분을 먼저 걷어내, 실제로 남을 메시지만 검사한다.
#   - `git commit -v` 가 붙이는 가위선(>8) 아래 diff 전체
#   - 주석 줄과 CR
#   - 앞뒤 빈 줄
# 이 과정을 거치지 않으면 diff 안의 문자열이나 템플릿 주석이 규칙 위반으로 잡힌다.
cleaned=$(
    sed -e '/^#[[:space:]]*-\{3,\}[[:space:]]*>8[[:space:]]*-\{3,\}/,$d' "$message_file" |
        sed -e 's/\r$//' -e '/^[[:space:]]*#/d' |
        awk '
            /[^[:space:]]/ {
                for (i = 0; i < pending; i++) print ""
                pending = 0
                print
                seen = 1
                next
            }
            seen { pending++ }
        '
)

# `git commit -m "...\n..."`의 일반 따옴표 안에서 \n은 개행으로 해석되지 않는다.
# 그대로 허용하면 여러 본문 항목이 한 줄에 저장되므로 실제 줄바꿈을 사용하게 강제한다.
if printf '%s\n' "$cleaned" | grep -qF '\n'; then
    printf '%s\n' '[commit-msg] 문자열 \n 대신 실제 줄바꿈을 사용해야 합니다.'
    printf '%s\n' '  여러 줄 메시지는 편집기 또는 git commit -F <메시지 파일>로 작성하세요.'
    exit 1
fi

subject=$(printf '%s\n' "$cleaned" | sed -n '1p')

# rebase --autosquash 가 합치면서 사라질 임시 커밋이다.
case "$subject" in
    'fixup! '* | 'squash! '*) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq \
    '^(build|ci|docs|feat|fix|perf|refactor|style|rename|remove|test) : [^[:space:]].*$' &&
    ! printf '%s\n' "$subject" | grep -Eq \
    '^\[FIX\] [^[:space:]].+$'; then
    echo "[commit-msg] 제목 형식이 올바르지 않습니다."
    echo "  예: feat : 회원 가입 API 추가"
    echo "  규칙: CONTRIBUTING.md의 커밋 메시지 규칙"
    exit 1
fi

# 이모지는 제목 어디에 있든 막는다. 형식만 검사하면 이전 형식의 이모지가
# 제목 안으로 자리만 옮긴 채 그대로 통과한다.
#   - `:sparkles:` 같은 코드 형태
#   - 실제 문자. 바이트를 고정 문자열로 비교해야 grep 구현을 타지 않는다.
#
# 문자를 하나씩 적으면 빠지는 것이 생긴다. UTF-8 앞 바이트로 블록째 막는다.
#   \360\237           U+1F300~U+1FAFF  🎉 🚀 🔥
#   \342\230 ~ \342\236 U+2600~U+27BF    ☀ ⚠ ⚡ ✅ ✨ ✔ ❗ ❤
#   \342\254, \342\255  U+2B00~U+2B7F    ⬅ ⭐
#   \357\270\217        U+FE0F           ❤️ 처럼 붙는 변이 선택자
# → · … — 같은 문장 기호는 U+2000~U+219F 라 이 범위 밖이다.
if printf '%s\n' "$subject" | grep -Eq ':[a-z_]+:' ||
    printf '%s\n' "$subject" | LC_ALL=C grep -qF \
        -e "$(printf '\360\237')" \
        -e "$(printf '\342\230')" -e "$(printf '\342\231')" -e "$(printf '\342\232')" \
        -e "$(printf '\342\233')" -e "$(printf '\342\234')" -e "$(printf '\342\235')" \
        -e "$(printf '\342\236')" -e "$(printf '\342\254')" -e "$(printf '\342\255')" \
        -e "$(printf '\357\270\217')"; then
    echo "[commit-msg] 제목에 이모지를 쓸 수 없습니다."
    echo "  예: feat : 회원 가입 API 추가"
    exit 1
fi

# 제목 다음 줄이 비어 있지 않으면 git 이 그 줄까지 제목으로 묶어 한 줄 로그가 깨진다.
if [ "$(printf '%s\n' "$cleaned" | wc -l)" -ge 2 ] &&
    [ -n "$(printf '%s\n' "$cleaned" | sed -n '2p')" ]; then
    echo "[commit-msg] 제목과 본문 사이에는 빈 줄이 필요합니다."
    exit 1
fi

if printf '%s\n' "$cleaned" | grep -Eiq '^(Co-authored-by:|Generated with)|🤖'; then
    echo "[commit-msg] 공동 작성자 또는 도구 서명은 사용할 수 없습니다."
    exit 1
fi

# 꼬릿말은 선택 사항이지만, 작성한다면 저장소 규칙의 이슈 형식만 허용한다.
invalid_footer=$(printf '%s\n' "$cleaned" | grep -Ei '^(Ref|Close):' |
    grep -Ev '^(Ref|Close): #[0-9]+$' || true)
if [ -n "$invalid_footer" ]; then
    echo "[commit-msg] 이슈 꼬릿말 형식이 올바르지 않습니다."
    echo "  예: Ref: #7 또는 Close: #7"
    exit 1
fi

# 꼬릿말도 본문과 빈 줄로 구분한다.
# 꼬릿말이 여러 줄이면 앞 줄도 꼬릿말이므로, 그 경우는 본문과 붙은 것이 아니다.
if printf '%s\n' "$cleaned" | awk '
        NR > 1 && /^(Ref|Close):/ && previous != "" && previous !~ /^(Ref|Close):/ { found = 1 }
        { previous = $0 }
        END { exit found ? 0 : 1 }
    '; then
    echo "[commit-msg] 본문과 꼬릿말 사이에는 빈 줄이 필요합니다."
    exit 1
fi

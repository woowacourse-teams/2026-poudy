# WebView가 표시할 Poudy 웹 클라이언트 주소입니다.
# 실기기에서는 localhost 대신 HTTPS 터널이나 접근 가능한 LAN 주소를 사용하세요.
EXPO_PUBLIC_WEB_URL=https://poudy.example.com

# 공유 텍스트를 Poudy 제품으로 연결할 API 기준 URL입니다.
EXPO_PUBLIC_API_BASE_URL=https://api.poudy.example.com

# 네이티브 빌드 식별자입니다. Play Console/App Store Connect 등록 전에 확정하세요.
POUDY_BUNDLE_IDENTIFIER=com.poudy.app

# 이 파일을 .env 로 복사해서 쓴다. 서버가 기동할 때 읽는다.

# CORS 를 열어 줄 클라이언트 도메인. 오리진 전체(스킴 + 호스트 + 포트)를 적는다.
# 여럿이면 쉼표로 잇는다: http://localhost:3000,https://poudy.example.com
# 서브도메인은 https://*.example.com 처럼 * 를 쓸 수 있다.
# 비워 두면 CORS 를 아예 열지 않는다. 운영은 nginx 가 같은 오리진에서
# /api 를 프록시하므로 비워 둔다.
CLIENT_DOMAIN=http://localhost:3000

# PostgreSQL 접속 정보. 적지 않으면 localhost:5432/poudy 에 OS 사용자명, 빈 비밀번호로 붙는다.
# 빈 값으로 적으면 기본값 대신 빈 문자열이 들어가므로 바꿀 때만 주석을 푼다.
# POUDY_DB_URL=jdbc:postgresql://localhost:5432/poudy
# POUDY_DB_USERNAME=postgres
# POUDY_DB_PASSWORD=

# 관리자 로그인 자격 증명. 실제 비밀번호는 이 파일에 저장하거나 커밋하지 않는다.
# 로컬에서는 server/.env 에만 값을 넣고, 운영에서는 배포 환경의 secret 주입 기능을 사용한다.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 의견 첨부 이미지를 저장할 S3 버킷과 Discord 알림 Webhook URL이다.
# AWS 자격 증명은 적지 않는다. 운영에서는 EC2 Instance Profile을 사용한다.
POUDY_FEEDBACK_S3_BUCKET=
POUDY_DISCORD_FEEDBACK_WEBHOOK_URL=

# 제품 등록 요청 접수를 알릴 Discord webhook. 비밀값이므로 로그나 코드에 남기지 않는다.
PRODUCT_REQUEST_DISCORD_WEBHOOK_URL=

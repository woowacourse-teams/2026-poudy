# 이 파일을 .env 로 복사해서 쓴다. 서버가 기동할 때 읽는다.

# CORS 를 열어 줄 클라이언트 도메인. 오리진 전체(스킴 + 호스트 + 포트)를 적는다.
# 여럿이면 쉼표로 잇는다: http://localhost:3000,https://poudy.example.com
# 서브도메인은 https://*.example.com 처럼 * 를 쓸 수 있다.
# 비워 두면 CORS 를 아예 열지 않는다. 운영은 nginx 가 같은 오리진에서
# /api 를 프록시하므로 비워 둔다.
CLIENT_DOMAIN=http://localhost:3000

# 제품 등록 요청 JSON을 한 건씩 저장할 S3 위치. AWS 인증은 기본 자격 증명 체인을 쓴다.
PRODUCT_REQUEST_S3_BUCKET=
PRODUCT_REQUEST_S3_PREFIX=product-requests
PRODUCT_REQUEST_S3_REGION=ap-northeast-2

# 제품 등록 요청 접수를 알릴 Discord webhook. 비밀값이므로 로그나 코드에 남기지 않는다.
PRODUCT_REQUEST_DISCORD_WEBHOOK_URL=

# 원격 주소 하나가 고정 시간 창 안에 보낼 수 있는 제품 등록 요청 수와 시간 창.
PRODUCT_REQUEST_RATE_LIMIT_MAX_REQUESTS=5
PRODUCT_REQUEST_RATE_LIMIT_WINDOW=PT1H

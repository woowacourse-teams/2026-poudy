{
  "openapi": "3.1.0",
  "info": {
    "title": "Poudy API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "카테고리",
      "description": "카테고리 조회 API"
    },
    {
      "name": "브랜드",
      "description": "브랜드 조회 API"
    },
    {
      "name": "제품",
      "description": "제품 조회 API"
    },
    {
      "name": "성분",
      "description": "성분 조회 API"
    }
  ],
  "paths": {
    "/api/products": {
      "get": {
        "tags": [
          "제품"
        ],
        "summary": "제품 조회",
        "description": "검색어와 필터 조건에 해당하는 제품 목록을 조회한다.",
        "operationId": "findProducts",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "토너"
            },
            "example": "토너"
          },
          {
            "name": "categoryIds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64",
                "example": 1
              },
              "uniqueItems": true
            }
          },
          {
            "name": "brandIds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64",
                "example": 12
              },
              "uniqueItems": true
            }
          },
          {
            "name": "moistureLevel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32",
                "example": 3,
                "maximum": 3,
                "minimum": 0
              },
              "uniqueItems": true
            }
          },
          {
            "name": "oilLevel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32",
                "example": 1,
                "maximum": 3,
                "minimum": 0
              },
              "uniqueItems": true
            }
          },
          {
            "name": "excludeCodes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "SENSITIVE",
                  "FRAGRANCE",
                  "ETHANOL",
                  "PARABEN_7",
                  "MINERAL_OIL",
                  "ALLERGEN"
                ]
              },
              "uniqueItems": true
            }
          },
          {
            "name": "includeIngredientIds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64",
                "example": 1005
              },
              "uniqueItems": true
            }
          },
          {
            "name": "excludeIngredientIds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64",
                "example": 1001
              },
              "uniqueItems": true
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "정렬 조건",
            "required": false,
            "schema": {
              "type": "string",
              "default": "NAME_ASC",
              "description": "정렬 조건",
              "enum": [
                "NAME_ASC",
                "NAME_DESC",
                "PRICE_ASC",
                "PRICE_DESC"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "조회할 페이지 번호 (0부터 시작)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "description": "조회할 페이지 번호 (0부터 시작)",
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "페이지당 항목 개수",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "description": "페이지당 항목 개수",
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "example": {
                  "title": "Bad Request",
                  "status": 400,
                  "detail": "요청 파라미터 값이 올바르지 않습니다.",
                  "code": "INVALID_QUERY_PARAMETER"
                }
              }
            }
          },
          "409": {
            "description": "요청 충돌",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "example": {
                  "title": "Conflict",
                  "status": 409,
                  "detail": "같은 성분을 포함과 제외에 함께 쓸 수 없습니다.",
                  "code": "CONFLICTING_INGREDIENT_FILTER"
                }
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "example": {
                  "title": "Internal Server Error",
                  "status": 500,
                  "detail": "서버에서 요청을 처리하지 못했습니다.",
                  "code": "INTERNAL_SERVER_ERROR"
                }
              }
            }
          }
        }
      }
    },

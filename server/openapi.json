      "get": {
        "description": "제품 ID 에 해당하는 기본 정보를 조회한다. 제품 목록 항목과 같은 형태다.",
        "operationId": "findProduct",
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"

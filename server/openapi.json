          },
          {
            "in": "query",
            "name": "moistureLevel",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32",
                "maximum": 3,
                "minimum": 0
              }
            }
          },
          {
            "in": "query",
            "name": "oilLevel",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32",
                "maximum": 3,
                "minimum": 0
              }
            }
          },
          {
            "in": "query",
            "name": "excludeCodes",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "SENSITIVE",
                  "FRAGRANCE",
                  "ETHANOL",
                  "PARABEN_7",
                  "MINERAL_OIL",
                  "ALLERGEN"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "includeIngredientIds",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            }
          },
          {
            "in": "query",
            "name": "excludeIngredientIds",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductCountResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "잘못된 요청"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "서버 오류"
          }
        },
        "summary": "제품 필터 결과 개수 조회",
        "tags": [
          "제품"
        ]
      }
    },
    "/api/products/detail/{productId}": {

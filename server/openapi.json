        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "in": "query",
            "name": "view",
            "required": false,
            "schema": {
              "type": "string",
              "default": "DETAIL",
              "enum": [
                "DETAIL",
                "SIMPLE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ProductDetailResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ProductResponse"
                    }
                  ]
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "product-controller"
        ]
      }

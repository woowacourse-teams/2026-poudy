          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "서버 오류"
          }
        },
        "summary": "제품 간단 조회",
        "tags": [
          "제품"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BenefitResponse": {
        "type": "object",
        "properties": {
          "color": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "ingredientIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "color",
          "id",
          "ingredientIds",
          "name"
        ]
      },
      "BrandListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BrandResponse"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "BrandResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "logoUrl": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "productCount": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "id",
          "logoUrl",
          "name",
          "productCount"
        ]
      },
      "BrandSummaryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "logoUrl": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "logoUrl",
          "name"
        ]
      },
      "CategoryChildResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "productCount": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "id",
          "name",
          "productCount"
        ]
      },
      "CategoryListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryResponse"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CategoryResponse": {
        "type": "object",
        "properties": {
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryChildResponse"
            }
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "productCount": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "children",
          "id",
          "name",
          "productCount"
        ]
      },
      "CategorySummaryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "EffectResponse": {
        "type": "object",
        "properties": {
          "color": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "color",
          "id",
          "name"
        ]
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_PATH_PARAMETER",
              "INVALID_QUERY_PARAMETER",
              "CONFLICTING_INGREDIENT_FILTER",
              "PRODUCT_NOT_FOUND",
              "BRAND_NOT_FOUND",
              "INGREDIENT_NOT_FOUND",
              "INTERNAL_SERVER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "IngredientDetailResponse": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "effectSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EffectResponse"
            }
          },
          "englishName": {
            "type": "string"
          },
          "groupCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SENSITIVE",
                "FRAGRANCE",
                "ETHANOL",
                "PARABEN_7",
                "MINERAL_OIL",
                "ALLERGEN"
              ]
            }
          },

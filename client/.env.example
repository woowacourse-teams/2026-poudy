# 이 파일을 .env.local 로 복사해서 쓴다.

# API 목 서버(MSW) 사용 여부. enabled 일 때만 켜진다.
# 실제 API 서버에 붙일 때는 값을 비우거나 지운다.
NEXT_PUBLIC_API_MOCKING=enabled

# API 서버 주소. 목을 쓰는 동안에는 요청이 나가지 않으므로 비워 둔다.
NEXT_PUBLIC_API_BASE_URL=

# 실행 환경. development 면 분석 이벤트를 보내지 않는다.
NEXT_PUBLIC_ENVIRONMENT=development

# canonical, Open Graph, robots.txt, sitemap.xml 에 쓸 웹 주소.
# 비우면 개발 기본값인 http://localhost:3000 을 쓴다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog. 키가 없으면 이벤트를 보내지 않는다.
NEXT_PUBLIC_POSTHOG_KEY=
# 비워 두면 같은 출처의 /ingest 로 보낸다. 광고 차단기를 피하려고 프록시를 거친다.
# PostHog 도메인으로 바로 보내려면 https://us.i.posthog.com 을 적는다.
NEXT_PUBLIC_POSTHOG_HOST=

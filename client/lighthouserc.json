{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage",
        "skipAudits": ["is-crawlable"]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci-report"
    }
  }
}

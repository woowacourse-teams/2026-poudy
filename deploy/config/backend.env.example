# Store the real values in /etc/poudy/backend.env (root:poudy, 0640).
POUDY_DB_URL=jdbc:postgresql://database.example.internal:5432/poudy?sslmode=require
POUDY_DB_USERNAME=poudy
POUDY_DB_PASSWORD=replace-me

# Required only while an empty database is initialized. The object is an SQL dump
# containing catalog rows, not the schema. Remove this value after validation.
POUDY_DB_INITIAL_DATA_S3_URI=s3://replace-me/poudy/postgresql/catalog.sql

POUDY_FEEDBACK_S3_BUCKET=replace-me
AWS_REGION=ap-northeast-2

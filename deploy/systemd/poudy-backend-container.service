[Unit]
Description=Poudy Spring Boot backend container
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/poudy/backend
EnvironmentFile=/etc/poudy/backend-image.env
ExecStartPre=/bin/bash -c '/usr/bin/install -d -o poudy -g poudy -m 0700 /var/lib/poudy-sessions'
ExecStart=/usr/local/sbin/poudy-backend-container-start
ExecStop=/bin/bash -c '/usr/bin/docker stop --time 30 poudy-backend || true'
ExecStopPost=/bin/bash -c '/usr/bin/docker rm --force poudy-backend >/dev/null 2>&1 || true'
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=45s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryMax=1G
CPUQuota=100%
TasksMax=256
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

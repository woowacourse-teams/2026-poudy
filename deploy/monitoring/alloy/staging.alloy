// Grafana Alloy configuration for the staging backend EC2.
// Supply CF_ACCESS_CLIENT_ID and CF_ACCESS_CLIENT_SECRET through the Alloy
// systemd environment; never put the service token in this file.

prometheus.remote_write "central" {
  endpoint {
    url = "https://metrics-write.poudy.site/api/v1/write"
    headers = {
      "CF-Access-Client-Id"     = sys.env("CF_ACCESS_CLIENT_ID"),
      "CF-Access-Client-Secret" = sys.env("CF_ACCESS_CLIENT_SECRET"),
    }
  }
}

prometheus.relabel "staging" {
  forward_to = [prometheus.remote_write.central.receiver]

  rule {
    action       = "replace"
    target_label = "environment"
    replacement  = "staging"
  }
}

prometheus.exporter.unix "staging" {
  enable_collectors = ["systemd"]

  systemd {
    enable_restarts = true
    unit_include    = "poudy-backend\\.service"
  }
}

prometheus.scrape "unix" {
  job_name   = "integrations/unix"
  targets   = prometheus.exporter.unix.staging.targets
  forward_to = [prometheus.relabel.staging.receiver]

  scrape_interval = "60s"
}

prometheus.exporter.process "backend" {
  matcher {
    comm = ["java"]
    name = "poudy-backend"
  }
}

prometheus.scrape "process" {
  job_name   = "integrations/process"
  targets   = prometheus.exporter.process.backend.targets
  forward_to = [prometheus.relabel.staging.receiver]

  scrape_interval = "60s"
}

prometheus.scrape "actuator" {
  job_name = "poudy_backend_actuator"
  targets = [
    {
      "__address__" = "127.0.0.1:8081",
      "environment" = "staging",
      "service"     = "poudy-backend",
    },
  ]
  metrics_path = "/actuator/prometheus"
  forward_to   = [prometheus.relabel.staging.receiver]

  scrape_interval = "60s"
}

// Probe the readiness endpoint separately from /actuator/prometheus so the
// health panel and alert reflect the backend's HTTP health response.
prometheus.exporter.blackbox "actuator_health" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s } } }"

  target {
    name    = "poudy_backend_actuator_health"
    address = "http://127.0.0.1:8081/actuator/health"
    module  = "http_2xx"
    labels = {
      "environment" = "staging",
      "service"     = "poudy-backend",
    }
  }
}

prometheus.scrape "actuator_health" {
  job_name        = "poudy_backend_actuator_health"
  targets         = prometheus.exporter.blackbox.actuator_health.targets
  forward_to      = [prometheus.relabel.staging.receiver]
  scrape_interval = "60s"
}

// Traces (stage 1, staging only). The backend container runs with
// --network host and exports OTLP HTTP to 127.0.0.1:4318. Alloy strips
// request data that must not leave the host, batches, and forwards to the
// central Tempo through Cloudflare Tunnel/Access like the Loki and Prometheus
// write paths.
otelcol.receiver.otlp "backend" {
  http {
    endpoint = "127.0.0.1:4318"
  }

  output {
    traces = [otelcol.processor.memory_limiter.backend.input]
  }
}

otelcol.processor.memory_limiter "backend" {
  check_interval = "1s"
  limit          = "128MiB"
  spike_limit    = "32MiB"

  output {
    traces = [otelcol.processor.transform.redact.input]
  }
}

// The backend already drops query strings and SQL bind values; this is the
// pipeline-side guard, matching how log filtering is enforced here. Search
// keywords arrive as query strings, and exception messages can carry request
// data (the log pipeline drops them for the same reason).
otelcol.processor.transform "redact" {
  error_mode = "ignore"

  trace_statements {
    context = "span"
    statements = [
      `replace_pattern(span.attributes["http.url"], "\\?.*$", "")`,
      `replace_pattern(span.attributes["url.full"], "\\?.*$", "")`,
      `delete_key(span.attributes, "url.query")`,
      `delete_matching_keys(span.attributes, "^jdbc\\.params.*")`,
      `set(span.status.message, "") where span.status.message != ""`,
    ]
  }

  trace_statements {
    context = "spanevent"
    statements = [
      `delete_key(spanevent.attributes, "exception.message")`,
      `delete_key(spanevent.attributes, "exception.stacktrace")`,
    ]
  }

  output {
    traces = [otelcol.processor.batch.backend.input]
  }
}

otelcol.processor.batch "backend" {
  timeout         = "5s"
  send_batch_size = 512

  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "https://traces-write.poudy.site"
    headers = {
      "CF-Access-Client-Id"     = sys.env("CF_ACCESS_CLIENT_ID"),
      "CF-Access-Client-Secret" = sys.env("CF_ACCESS_CLIENT_SECRET"),
    }
  }
}

loki.write "central" {
  endpoint {
    url = "https://logs-write.poudy.site/loki/api/v1/push"
    headers = {
      "CF-Access-Client-Id"     = sys.env("CF_ACCESS_CLIENT_ID"),
      "CF-Access-Client-Secret" = sys.env("CF_ACCESS_CLIENT_SECRET"),
    }
  }
}

loki.process "backend" {
  forward_to = [loki.write.central.receiver]

  // Same rules as production-backend.alloy. Keep only the first line of each
  // log entry: Spring log lines start with an ISO date, while exception class
  // and message lines, "Caused by:", stack frames, continuation lines of
  // multi-line messages, and the startup banner do not. Those can carry
  // request data, so they never reach Loki.
  stage.match {
    selector            = "{service=\"poudy-backend\"} !~ \"^[0-9]{4}-[0-9]{2}-[0-9]{2}T\""
    action              = "drop"
    drop_counter_reason = "non_first_line"
  }

  // Product search and shared-text search events carry the raw search text.
  stage.drop {
    expression          = ".*searchType=.*"
    drop_counter_reason = "search_event"
  }
}

loki.source.journal "backend" {
  // poudy-backend.service runs the container attached (exec docker run), so the
  // unit journal already has every application line. The Docker journald driver
  // writes the same lines again under SYSLOG_IDENTIFIER=poudy-backend; reading
  // both would send each line to Loki twice.
  matches    = "_SYSTEMD_UNIT=poudy-backend.service"
  max_age    = "1h"
  labels     = { environment = "staging", service = "poudy-backend" }
  forward_to = [loki.process.backend.receiver]
}

// Host system logs: kernel warnings and errors (OOM kills, disk and network
// failures), systemd start/stop/failure events for the watched units, and
// sshd sessions. sudo is not collected: its lines carry full command lines,
// which can include secrets.
loki.source.journal "system_kernel" {
  matches    = "_TRANSPORT=kernel PRIORITY=0 PRIORITY=1 PRIORITY=2 PRIORITY=3 PRIORITY=4"
  max_age    = "1h"
  labels     = { environment = "staging", service = "system", role = "backend", source = "kernel" }
  forward_to = [loki.write.central.receiver]
}

loki.source.journal "system_units" {
  // Messages PID 1 writes about a unit (Started, Stopped, Failed with result,
  // Scheduled restart). The units' own output is collected separately.
  matches    = "_PID=1 UNIT=poudy-backend.service UNIT=alloy.service UNIT=docker.service"
  max_age    = "1h"
  labels     = { environment = "staging", service = "system", role = "backend", source = "systemd" }
  forward_to = [loki.write.central.receiver]
}

loki.source.journal "system_sshd" {
  matches    = "_SYSTEMD_UNIT=sshd.service"
  max_age    = "1h"
  labels     = { environment = "staging", service = "system", role = "backend", source = "sshd" }
  forward_to = [loki.write.central.receiver]
}

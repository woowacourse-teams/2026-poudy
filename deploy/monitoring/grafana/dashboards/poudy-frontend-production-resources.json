    {
      "id": 8,
      "type": "timeseries",
      "title": "Network Throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{environment=\"prod\",service=\"poudy-frontend\",job=\"integrations/unix\",device!~\"lo|docker.*|br-.*|veth.*\"}[5m]))",
          "legendFormat": "{{device}} RX"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (device) (rate(node_network_transmit_bytes_total{environment=\"prod\",service=\"poudy-frontend\",job=\"integrations/unix\",device!~\"lo|docker.*|br-.*|veth.*\"}[5m]))",
          "legendFormat": "{{device}} TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "max": null,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Host network receive/transmit throughput, excluding loopback and virtual Docker bridge interfaces."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Swap Used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "node_memory_SwapTotal_bytes{environment=\"prod\",service=\"poudy-frontend\",job=\"integrations/unix\"} - node_memory_SwapFree_bytes{environment=\"prod\",service=\"poudy-frontend\",job=\"integrations/unix\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "max": null,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Host swap currently occupied. A zero or absent series can mean swap is not configured."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Swap Activity (pages/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "rate(node_vmstat_pswpin{environment=\"prod\",service=\"poudy-frontend\",job=\"integrations/unix\"}[5m])",
          "legendFormat": "pages in/s"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "rate(node_vmstat_pswpout{environment=\"prod\",service=\"poudy-frontend\",job=\"integrations/unix\"}[5m])",
          "legendFormat": "pages out/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": null,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Host swap-in and swap-out activity; sustained growth can indicate memory pressure."
    },
    {
      "id": 11,
      "type": "stat",
      "title": "OOM Kills (24h)",
      "description": "Linux OOM killer invocations in the last 24 hours. This is a diagnostic signal, not an alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(increase(node_vmstat_oom_kill{environment=\"prod\",job=\"integrations/unix\"}[24h]))",
          "legendFormat": "OOM kills"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      }
    }

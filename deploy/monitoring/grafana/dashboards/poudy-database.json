{
  "id": null,
  "uid": "poudy-database",
  "title": "Poudy Database - Shared PostgreSQL",
  "tags": [
    "poudy",
    "database",
    "postgresql"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 2,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PostgreSQL Up",
      "description": "Exporter scrape result for the shared PostgreSQL EC2.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "up{job=\"integrations/postgres\",environment=\"shared\"}",
          "legendFormat": "PostgreSQL"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Connections by database",
      "description": "Current backend connections by logical database; PostgreSQL max_connections is 100 at setup time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "pg_stat_database_numbackends{environment=\"shared\",datname=~\"poudy_prod|poudy_staging\"}",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Database size",
      "description": "Current disk footprint of the production and staging logical databases.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "pg_database_size_bytes{environment=\"shared\",datname=~\"poudy_prod|poudy_staging\"}",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "PostgreSQL activity",
      "description": "Active sessions and currently held locks, split by logical database where available.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (datname) (pg_stat_activity_count{environment=\"shared\",datname=~\"poudy_prod|poudy_staging\",state=\"active\"})",
          "legendFormat": "active {{datname}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (datname) (pg_locks_count{environment=\"shared\",datname=~\"poudy_prod|poudy_staging\"})",
          "legendFormat": "locks {{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DB host CPU",
      "description": "CPU utilization on the EC2 shared by production and staging databases.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{environment=\"shared\",mode=\"idle\"}[5m])))",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB host memory available",
      "description": "Available memory on the shared DB EC2. No alert threshold is set before a baseline is established.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "node_memory_MemAvailable_bytes{environment=\"shared\"}",
          "legendFormat": "Available"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Root filesystem free",
      "description": "Free bytes and used percentage for the DB EC2 root filesystem.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "node_filesystem_avail_bytes{environment=\"shared\",mountpoint=\"/\"}",
          "legendFormat": "Free bytes"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "100 * (1 - node_filesystem_avail_bytes{environment=\"shared\",mountpoint=\"/\"} / node_filesystem_size_bytes{environment=\"shared\",mountpoint=\"/\"})",
          "legendFormat": "Used %",
          "yAxis": {
            "placement": "right"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "PostgreSQL service",
      "description": "systemd state of postgresql.service (1 = active).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "node_systemd_unit_state{environment=\"shared\",job=\"integrations/unix\",name=\"postgresql.service\",state=\"active\"}",
          "legendFormat": "active"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "STOPPED",
                  "color": "red"
                },
                "1": {
                  "text": "ACTIVE",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "DB backup timer last trigger",
      "description": "Age of the last poudy-db-backup.timer trigger. Review journal logs for service result and S3 upload confirmation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 24,
        "w": 18,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "time() - node_systemd_timer_last_trigger_seconds{environment=\"shared\",job=\"integrations/unix\",name=\"poudy-db-backup.timer\"}",
          "legendFormat": "seconds since trigger"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Database Disk I/O",
      "description": "Shared PostgreSQL host block-device read/write throughput.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (device) (rate(node_disk_read_bytes_total{environment=\"shared\",service=\"poudy-database\",job=\"integrations/unix\",device!~\"loop.*|ram.*\"}[5m]))",
          "legendFormat": "read {{device}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (device) (rate(node_disk_written_bytes_total{environment=\"shared\",service=\"poudy-database\",job=\"integrations/unix\",device!~\"loop.*|ram.*\"}[5m]))",
          "legendFormat": "write {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Active PostgreSQL Wait Events",
      "description": "Active sessions waiting on PostgreSQL events, grouped by database and wait event.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "pg_activity_waits_waiting_sessions{environment=\"shared\",service=\"poudy-database\",database_name=\"poudy_prod\"}",
          "legendFormat": "prod {{wait_event_type}} / {{wait_event}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "pg_activity_waits_waiting_sessions{environment=\"shared\",service=\"poudy-database\",database_name=\"poudy_staging\"}",
          "legendFormat": "staging {{wait_event_type}} / {{wait_event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Staging Top Query Time",
      "description": "Top staging query IDs by cumulative execution time rate. SQL text is not exported.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "topk(10, rate(pg_stat_statements_seconds_total{environment=\"shared\",service=\"poudy-database\",datname=\"poudy_staging\"}[5m]))",
          "legendFormat": "query {{queryid}} · {{user}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Staging Mean Query Time",
      "description": "Approximate mean execution time per staging query ID over five minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "1000 * sum by (queryid) (rate(pg_stat_statements_seconds_total{environment=\"shared\",service=\"poudy-database\",datname=\"poudy_staging\"}[5m])) / clamp_min(sum by (queryid) (rate(pg_stat_statements_calls_total{environment=\"shared\",service=\"poudy-database\",datname=\"poudy_staging\"}[5m])), 0.001)",
          "legendFormat": "query {{queryid}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}

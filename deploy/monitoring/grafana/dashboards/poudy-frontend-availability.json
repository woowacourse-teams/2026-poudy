      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "probe_success{job=\"poudy_public_endpoints\",environment=\"production\",endpoint=\"frontend_page\"}",
          "legendFormat": "page"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",

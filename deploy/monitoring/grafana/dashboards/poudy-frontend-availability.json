      "id": 5,
      "type": "timeseries",
      "title": "Endpoint Response Time",
      "description": "HTTP probe duration measured from the Monitoring EC2. It includes DNS, connection, TLS, and response time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9

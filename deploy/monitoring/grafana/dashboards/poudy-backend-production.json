        "x": 0,
        "y": 35,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{environment=\"prod\",job=\"poudy-backend\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}"

          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Backend HTTP request rate by route template and method. Actuator requests are excluded."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "API 5xx Rate (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 35,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{environment=\"prod\",job=\"poudy-backend\",status=~\"5..\",uri!~\"/actuator.*\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{environment=\"prod\",job=\"poudy-backend\",uri!~\"/actuator.*\"}[5m])), 0.001)",
          "legendFormat": "5xx requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Share of backend HTTP requests returning 5xx in the last five minutes. No performance alert is configured."
    },
